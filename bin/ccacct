#!/usr/bin/env bash
# ccacct — mehrere Claude-Code-Accounts parallel halten und nahtlos wechseln.
#
# Grundprinzip: Das Setup existiert genau EINMAL, im Primärprofil (~/.claude).
# Jedes weitere Profil ist ein eigenes CLAUDE_CONFIG_DIR, dessen Inhalte per
# Symlink auf das Primärprofil zeigen — es werden keine Kopien angelegt.
# Getrennt ist ausschließlich, was den eingeloggten Account ausmacht.
#
# Deshalb Denylist statt Allowlist: alles im Primärprofil wird geteilt, außer
# den unten in ISOLATED aufgeführten Einträgen. Neue Dateien, die Claude Code
# oder du künftig anlegst, sind damit automatisch in jedem Profil vorhanden.
set -uo pipefail

PRIMARY="${CCACCT_PRIMARY:-$HOME/.claude}"
ROOT="${CCACCT_ROOT:-$HOME/.claude-accounts}"
CLAUDE_BIN="${CCACCT_CLAUDE_BIN:-claude}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# Nicht teilen — accountgebunden, sessiongebunden oder gefährlich zu verlinken.
ISOLATED=(
  .credentials.json          # OAuth-Tokens: DAS unterscheidet die Accounts
  .claude.json               # enthält oauthAccount; wird stattdessen gemergt
  .config.json               # würde Claude Codes Pfadauflösung kapern
  .git .gitignore            # ~/.claude ist ein Repo; ein Link machte das Profil zum Worktree
  history.jsonl              # Prompt-History der Sessions
  sessions tasks jobs queue  # laufender Sessionzustand
  file-history session-env shell-snapshots
  cache paste-cache statsig todos stats-cache.json
  daemon daemon.lock daemon.log daemon.status.json
  .autocontinue .autoresume
  .last-cleanup .last-update-result.json
  diary-extract.log
  .ccacct-isolate-projects
)
# Nur bei --isolate-projects zusätzlich isoliert.
OPTIONAL_ISOLATED=(projects)

# Schlüssel in .claude.json, die zum Account gehören und NICHT übernommen werden.
# Alles andere (mcpServers, projects samt Trust und Permissions, skillUsage,
# Onboarding-Flags …) wird aus dem Primärprofil gespiegelt.
ACCOUNT_KEYS='[
  "oauthAccount", "userID", "machineID", "customApiKeyResponses",
  "numStartups", "firstStartTime", "claudeCodeFirstTokenDate",
  "passesEligibilityCache", "passesLastSeenRemaining", "passesUpsellSeenCount",
  "hasVisitedPasses", "overageCreditGrantCache", "cachedExtraUsageDisabledReason",
  "hasVisitedExtraUsage", "metricsStatusCache", "subscriptionNoticeCount",
  "fotwUpsellFulfilled", "cachedGrowthBookFeatures", "cachedGrowthBookFeaturesAt",
  "cachedExperimentFeatures", "cachedExperimentData", "groveConfigCache",
  "clientDataCacheSlots", "additionalModelOptionsCache", "isQualifiedForDataSharing",
  "penguinModeOrgEnabled", "announcementImpressions", "seenNotifications",
  "remoteControlUpsellSeenCount", "fullscreenUpsellSeenCount", "overageCreditGrant"
]'

# Eine .claude.json, die jünger als das ist, gehört vermutlich zu einer laufenden
# Session — dann nicht hineinschreiben (außer mit --force).
LIVE_WINDOW_SECONDS=120

# ------------------------------------------------------------------ Helfer ----
die()  { printf '\033[31mFehler:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

is_isolated() {
  local item="$1" isolate_projects="$2" x
  for x in "${ISOLATED[@]}"; do [ "$item" = "$x" ] && return 0; done
  if [ "$isolate_projects" = "yes" ]; then
    for x in "${OPTIONAL_ISOLATED[@]}"; do [ "$item" = "$x" ] && return 0; done
  fi
  case "$item" in *.log) return 0 ;; esac
  return 1
}

is_valid_name() {
  case "$1" in
    ''|*/*|*' '*|.|..|.*) return 1 ;;
    default)              return 1 ;;
    *) [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ;;
  esac
}

profile_dir() {
  local name="$1"
  if [ "$name" = "default" ]; then printf '%s\n' "$PRIMARY"; return 0; fi
  is_valid_name "$name" || return 1
  [ -d "$ROOT/$name" ] || return 1
  printf '%s\n' "$ROOT/$name"
}

# Das globale .claude.json liegt bei gesetztem CLAUDE_CONFIG_DIR *in* diesem
# Verzeichnis, sonst in $HOME.
global_json_for() {
  local dir="$1"
  if [ "$dir" = "$PRIMARY" ]; then
    printf '%s\n' "$(dirname "$PRIMARY")/.claude.json"
  else
    printf '%s\n' "$dir/.claude.json"
  fi
}

isolate_flag_for() {
  [ -e "$1/.ccacct-isolate-projects" ] && printf 'yes\n' || printf 'no\n'
}

list_profiles() {
  printf 'default\n'
  [ -d "$ROOT" ] || return 0
  local d
  for d in "$ROOT"/*/; do
    [ -d "$d" ] || continue
    basename "$d"
  done | sort
}

account_info() {
  local dir="$1"
  python3 - "$dir/.credentials.json" "$(global_json_for "$dir")" <<'PY'
import json, sys, time

def load(p):
    try:
        with open(p) as fh:
            return json.load(fh)
    except Exception:
        return {}

cred = load(sys.argv[1]).get("claudeAiOauth") or {}
acct = load(sys.argv[2]).get("oauthAccount") or {}

email = acct.get("emailAddress") or "—"
sub = cred.get("subscriptionType") or "—"

if not cred.get("accessToken"):
    status = "nicht eingeloggt"
else:
    now = time.time() * 1000
    exp, ref = cred.get("expiresAt"), cred.get("refreshTokenExpiresAt")
    if isinstance(exp, (int, float)) and exp < now:
        renewable = isinstance(ref, (int, float)) and ref > now
        status = "Token abgelaufen (erneuerbar)" if renewable else "abgelaufen"
    else:
        status = "aktiv"

print("%s|%s|%s" % (email, sub, status))
PY
}

# -------------------------------------------------------- Setup-Spiegelung ----
share_one() {
  local src="$1" dst="$2"
  [ -e "$src" ] || return 0
  if [ -L "$dst" ]; then
    [ "$(readlink "$dst")" = "$src" ] && return 0
    rm -f "$dst"
  elif [ -e "$dst" ]; then
    # Claude Code hat den Link durch eine echte Datei ersetzt (atomarer Write).
    rm -rf "$dst"
  fi
  ln -s "$src" "$dst"
}

link_shared() {
  local dir="$1" isolate_projects="$2" item
  for item in $(cd "$PRIMARY" && ls -A); do
    is_isolated "$item" "$isolate_projects" && continue
    share_one "$PRIMARY/$item" "$dir/$item"
  done
  # Verwaiste Links entfernen (im Primärprofil gelöscht oder jetzt isoliert).
  for item in $(cd "$dir" && ls -A); do
    [ -L "$dir/$item" ] || continue
    case "$(readlink "$dir/$item")" in
      "$PRIMARY"/*) ;;
      *) continue ;;
    esac
    if [ ! -e "$PRIMARY/$item" ] || is_isolated "$item" "$isolate_projects"; then
      rm -f "$dir/$item"
    fi
  done
}

# .claude.json ist der einzige Ort, an dem Setup und Account-Identität in einer
# Datei stecken (mcpServers/projects neben oauthAccount). Sie kann deshalb nicht
# verlinkt werden — stattdessen wird alles außer den ACCOUNT_KEYS gespiegelt.
merge_claude_json() {
  local dir="$1" force="$2"
  local src dst
  src="$(global_json_for "$PRIMARY")"
  dst="$(global_json_for "$dir")"
  [ -f "$src" ] || return 0
  python3 - "$src" "$dst" "$force" "$LIVE_WINDOW_SECONDS" "$ACCOUNT_KEYS" <<'PY'
import json, os, sys, time, tempfile

src, dst, force, window, account_keys = sys.argv[1:6]
account_keys = set(json.loads(account_keys))

def load(p):
    try:
        with open(p) as fh:
            return json.load(fh)
    except Exception:
        return {}

if force != "yes" and os.path.exists(dst):
    if time.time() - os.path.getmtime(dst) < float(window):
        print("SKIPPED")
        sys.exit(0)

primary, profile = load(src), load(dst)

for key, value in primary.items():
    if key in account_keys:
        continue
    if key == "projects" and isinstance(value, dict):
        merged = dict(profile.get("projects") or {})
        merged.update(value)          # Primärprofil gewinnt, Eigenes bleibt erhalten
        profile["projects"] = merged
    else:
        profile[key] = value

# Im Primärprofil entfernte Setup-Schlüssel auch im Profil entfernen.
for key in [k for k in profile if k not in primary and k not in account_keys]:
    del profile[key]

os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dst) or ".", prefix=".claude.json.")
with os.fdopen(fd, "w") as fh:
    json.dump(profile, fh, indent=2)
os.replace(tmp, dst)
os.chmod(dst, 0o600)
print("MERGED")
PY
}

sync_profile() {
  local name="$1" links_only="$2" force="$3" dir isolate result
  dir="$(profile_dir "$name")" || return 1
  isolate="$(isolate_flag_for "$dir")"
  link_shared "$dir" "$isolate"
  if [ "$links_only" = "yes" ]; then
    info "synchronisiert: $name (nur Links)"
    return 0
  fi
  result="$(merge_claude_json "$dir" "$force")"
  if [ "$result" = "SKIPPED" ]; then
    info "synchronisiert: $name (Links; .claude.json uebersprungen — laufende Session, ggf. --force)"
  else
    info "synchronisiert: $name"
  fi
}

# ---------------------------------------------------------------- Befehle ----
cmd_add() {
  local name="" isolate=no arg
  for arg in "$@"; do
    case "$arg" in
      --isolate-projects) isolate=yes ;;
      -*) die "unbekannte Option: $arg" ;;
      *)  [ -n "$name" ] && die "zu viele Argumente"; name="$arg" ;;
    esac
  done
  [ -n "$name" ] || die "Name fehlt — Aufruf: ccacct add <name> [--isolate-projects]"
  [ "$name" = "default" ] && die "'default' ist reserviert für dein bestehendes $PRIMARY"
  is_valid_name "$name" || die "ungültiger Profilname: $name"
  [ -d "$ROOT/$name" ] && die "Profil '$name' existiert bereits"
  [ -d "$PRIMARY" ] || die "Primärprofil nicht gefunden: $PRIMARY"

  mkdir -p "$ROOT/$name" || die "konnte $ROOT/$name nicht anlegen"
  chmod 700 "$ROOT/$name"
  [ "$isolate" = "yes" ] && : > "$ROOT/$name/.ccacct-isolate-projects"
  link_shared "$ROOT/$name" "$isolate"
  merge_claude_json "$ROOT/$name" yes >/dev/null

  info "Profil '$name' angelegt: $ROOT/$name"
  info "Setup zeigt per Symlink auf $PRIMARY — es wurde nichts kopiert."
  info "Jetzt anmelden mit:  ccacct login $name"
}

cmd_login() {
  local name="${1:-}"
  [ -n "$name" ] || die "Name fehlt — Aufruf: ccacct login <name>"
  local dir
  dir="$(profile_dir "$name")" || die "unbekanntes Profil: $name"
  info "Starte Claude Code für Profil '$name'."
  info "Falls kein Login-Dialog erscheint, tippe im Chat: /login"
  if [ "$name" = "default" ]; then
    exec "$CLAUDE_BIN"
  else
    exec env CLAUDE_CONFIG_DIR="$dir" "$CLAUDE_BIN"
  fi
}

cmd_logout() {
  local name="${1:-}"
  [ -n "$name" ] || die "Name fehlt — Aufruf: ccacct logout <name>"
  [ "$name" = "default" ] && die "Für das Primärprofil bitte 'claude /logout' verwenden"
  local dir
  dir="$(profile_dir "$name")" || die "unbekanntes Profil: $name"
  exec env CLAUDE_CONFIG_DIR="$dir" "$CLAUDE_BIN" /logout
}

cmd_list() {
  local active_dir="${CLAUDE_CONFIG_DIR:-}" name dir marker rows=""
  while read -r name; do
    dir="$(profile_dir "$name")" || continue
    marker=" "
    if [ -n "$active_dir" ]; then
      [ "$active_dir" = "$dir" ] && marker="*"
    elif [ "$name" = "default" ]; then
      marker="*"
    fi
    rows+="$marker|$name|$(account_info "$dir")"$'\n'
  done < <(list_profiles)

  # Ausrichtung in Python, weil bash' printf Bytes statt Zeichen zählt.
  printf '%s' "$rows" | python3 -c '
import sys
rows = [l.split("|") for l in sys.stdin.read().splitlines() if l.strip()]
head = [" ", "PROFIL", "ACCOUNT", "ABO", "STATUS"]
widths = [max(len(r[i]) for r in [head] + rows) for i in range(4)]
def fmt(r, bold=False):
    line = "  ".join([r[i].ljust(widths[i]) for i in range(4)] + [r[4]]).rstrip()
    return "\033[1m%s\033[0m" % line if bold else line
print(fmt(head, bold=True))
for r in rows:
    print(fmt(r))
'
}

cmd_which() {
  local active_dir="${CLAUDE_CONFIG_DIR:-}" name dir
  if [ -z "$active_dir" ]; then printf 'default\n'; return 0; fi
  while read -r name; do
    dir="$(profile_dir "$name")" || continue
    if [ "$active_dir" = "$dir" ]; then printf '%s\n' "$name"; return 0; fi
  done < <(list_profiles)
  printf '%s (unbekanntes Configdir)\n' "$active_dir"
}

cmd_path() {
  local name="${1:-}"
  [ -n "$name" ] || die "Name fehlt — Aufruf: ccacct path <name>"
  local dir
  dir="$(profile_dir "$name")" || die "unbekanntes Profil: $name"
  printf '%s\n' "$dir"
}

cmd_run() {
  local name="${1:-}"
  [ -n "$name" ] || die "Name fehlt — Aufruf: ccacct run <name> [claude-args…]"
  shift
  local dir
  dir="$(profile_dir "$name")" || die "unbekanntes Profil: $name"
  if [ "$name" = "default" ]; then
    exec env -u CLAUDE_CONFIG_DIR "$CLAUDE_BIN" "$@"
  else
    exec env CLAUDE_CONFIG_DIR="$dir" "$CLAUDE_BIN" "$@"
  fi
}

cmd_exec() {
  local name="${1:-}"
  [ -n "$name" ] || die "Name fehlt — Aufruf: ccacct exec <name> -- <kommando…>"
  shift
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "Kommando fehlt"
  local dir
  dir="$(profile_dir "$name")" || die "unbekanntes Profil: $name"
  if [ "$name" = "default" ]; then
    exec env -u CLAUDE_CONFIG_DIR "$@"
  else
    exec env CLAUDE_CONFIG_DIR="$dir" "$@"
  fi
}

cmd_sync() {
  local target="" links_only=no force=no quiet=no arg
  for arg in "$@"; do
    case "$arg" in
      --all)        target="--all" ;;
      --links-only) links_only=yes ;;
      --force|-f)   force=yes ;;
      --quiet|-q)   quiet=yes ;;
      -*)           die "unbekannte Option: $arg" ;;
      *)            target="$arg" ;;
    esac
  done
  [ -n "$target" ] || target="--all"

  local out name dir
  if [ "$target" = "--all" ]; then
    [ -d "$ROOT" ] || { [ "$quiet" = yes ] || info "Keine Profile vorhanden."; return 0; }
    for dir in "$ROOT"/*/; do
      [ -d "$dir" ] || continue
      name="$(basename "$dir")"
      out="$(sync_profile "$name" "$links_only" "$force")"
      [ "$quiet" = yes ] || info "$out"
    done
  else
    [ "$target" = "default" ] && die "Das Primärprofil ist die Quelle — nichts zu synchronisieren"
    profile_dir "$target" >/dev/null || die "unbekanntes Profil: $target"
    out="$(sync_profile "$target" "$links_only" "$force")"
    [ "$quiet" = yes ] || info "$out"
  fi
}

# Meldet Abweichungen eines Profils vom Primärprofil auf stdout, Exitcode 1 bei Drift.
check_profile() {
  local name="$1" dir isolate item drift=0 link
  dir="$(profile_dir "$name")" || return 2
  isolate="$(isolate_flag_for "$dir")"

  for item in $(cd "$PRIMARY" && ls -A); do
    is_isolated "$item" "$isolate" && continue
    if [ ! -L "$dir/$item" ]; then
      printf '  %s: kein Symlink auf das Primärprofil\n' "$item"; drift=1; continue
    fi
    link="$(readlink "$dir/$item")"
    if [ "$link" != "$PRIMARY/$item" ]; then
      printf '  %s: zeigt auf %s statt auf %s\n' "$item" "$link" "$PRIMARY/$item"; drift=1
    fi
  done

  local missing
  missing="$(python3 - "$(global_json_for "$PRIMARY")" "$(global_json_for "$dir")" "$ACCOUNT_KEYS" <<'PY'
import json, sys

def load(p):
    try:
        with open(p) as fh:
            return json.load(fh)
    except Exception:
        return {}

primary, profile, account_keys = load(sys.argv[1]), load(sys.argv[2]), set(json.loads(sys.argv[3]))
for key, value in primary.items():
    if key in account_keys:
        continue
    if key not in profile:
        print("  .claude.json: Schlüssel '%s' fehlt" % key)
    elif key != "projects" and profile[key] != value:
        print("  .claude.json: Schlüssel '%s' weicht ab" % key)
    elif key == "projects" and isinstance(value, dict):
        for proj, cfg in value.items():
            if (profile.get("projects") or {}).get(proj) != cfg:
                print("  .claude.json: projects['%s'] weicht ab" % proj)
PY
)"
  if [ -n "$missing" ]; then printf '%s\n' "$missing"; drift=1; fi
  return $drift
}

cmd_doctor() {
  local target="" fix=no arg rc=0
  for arg in "$@"; do
    case "$arg" in
      --all)      target="--all" ;;
      --fix)      fix=yes ;;
      -*)         die "unbekannte Option: $arg" ;;
      *)          target="$arg" ;;
    esac
  done
  [ -n "$target" ] || target="--all"

  local names name out
  if [ "$target" = "--all" ]; then
    names="$(list_profiles | grep -v '^default$')"
    [ -n "$names" ] || { info "Keine weiteren Profile vorhanden."; return 0; }
  else
    [ "$target" = "default" ] && die "Das Primärprofil ist die Referenz"
    profile_dir "$target" >/dev/null || die "unbekanntes Profil: $target"
    names="$target"
  fi

  while read -r name; do
    [ -n "$name" ] || continue
    if [ "$fix" = "yes" ]; then
      sync_profile "$name" no yes >/dev/null
    fi
    out="$(check_profile "$name")"
    if [ -z "$out" ]; then
      printf '\033[32m✓\033[0m %s — identisch mit default\n' "$name"
    else
      printf '\033[31m✗\033[0m %s — Abweichungen:\n%s\n' "$name" "$out"
      rc=1
    fi
  done <<< "$names"

  [ "$rc" -eq 0 ] || info "Beheben mit: ccacct doctor ${target} --fix"
  return $rc
}

# Hook in der (geteilten) settings.json, der bei jedem Sessionstart die Links
# nachzieht — so bleibt das Setup identisch, ohne dass du daran denken musst.
cmd_autosync() {
  local action="${1:-status}"
  local settings="$PRIMARY/settings.json"
  local command="CCACCT_AUTOSYNC=1 \"$SELF\" sync --all --links-only --quiet"
  case "$action" in
    install|uninstall|status) ;;
    *) die "Aufruf: ccacct autosync install|uninstall|status" ;;
  esac
  python3 - "$settings" "$command" "$action" <<'PY'
import json, os, sys, tempfile

path, command, action = sys.argv[1], sys.argv[2], sys.argv[3]
marker = "CCACCT_AUTOSYNC"

try:
    with open(path) as fh:
        settings = json.load(fh)
except FileNotFoundError:
    settings = {}
except Exception as exc:
    sys.exit("settings.json ist nicht lesbar: %s" % exc)

hooks = settings.setdefault("hooks", {})
groups = hooks.setdefault("SessionStart", [])

def has_hook():
    for group in groups:
        for hook in group.get("hooks", []):
            if marker in str(hook.get("command", "")):
                return True
    return False

if action == "status":
    print("autosync ist %s" % ("installiert" if has_hook() else "nicht installiert"))
    sys.exit(0)

if action == "install":
    if has_hook():
        print("autosync ist bereits installiert")
        sys.exit(0)
    groups.append({"hooks": [{"type": "command", "command": command, "timeout": 15}]})
elif action == "uninstall":
    if not has_hook():
        print("autosync war nicht installiert")
        sys.exit(0)
    for group in groups:
        group["hooks"] = [h for h in group.get("hooks", [])
                          if marker not in str(h.get("command", ""))]
    hooks["SessionStart"] = [g for g in groups if g.get("hooks")]
    if not hooks["SessionStart"]:
        del hooks["SessionStart"]
    if not hooks:
        del settings["hooks"]

# settings.json kann ein Symlink ins Primärprofil sein — Ziel beschreiben, nicht ersetzen.
target = os.path.realpath(path)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target) or ".", prefix=".settings.json.")
with os.fdopen(fd, "w") as fh:
    json.dump(settings, fh, indent=2)
os.replace(tmp, target)
print("autosync %s" % ("installiert" if action == "install" else "entfernt"))
PY
}

cmd_rm() {
  local name="" force=no arg
  for arg in "$@"; do
    case "$arg" in
      --force|-f) force=yes ;;
      -*) die "unbekannte Option: $arg" ;;
      *)  [ -n "$name" ] && die "zu viele Argumente"; name="$arg" ;;
    esac
  done
  [ -n "$name" ] || die "Name fehlt — Aufruf: ccacct rm <name> --force"
  [ "$name" = "default" ] && die "Das Primärprofil ($PRIMARY) wird von ccacct niemals gelöscht"
  is_valid_name "$name" || die "ungültiger Profilname: $name"
  [ -d "$ROOT/$name" ] || die "unbekanntes Profil: $name"
  if [ "$force" != "yes" ]; then
    die "Löscht Anmeldung, Sessions und History von '$name'. Bestätige mit: ccacct rm $name --force"
  fi
  # Symlinks zuerst entfernen, damit kein rm -rf durch einen Link läuft.
  find "$ROOT/$name" -type l -delete 2>/dev/null
  rm -rf "${ROOT:?}/${name:?}"
  info "Profil '$name' gelöscht. Geteilte Inhalte in $PRIMARY sind unangetastet."
}

cmd_shell_init() {
  local shell="${1:-}"
  case "$shell" in
    fish) cat <<EOF
# ccacct — fish-Integration.  In config.fish:  ccacct shell-init fish | source
function ccacct --description 'Claude-Code-Accounts verwalten und wechseln'
    if test (count \$argv) -ge 1; and test "\$argv[1]" = use
        if test (count \$argv) -lt 2
            echo "Aufruf: ccacct use <name>" >&2
            return 1
        end
        set -l name \$argv[2]
        if test "\$name" = default
            set -e CLAUDE_CONFIG_DIR
            echo "Aktives Profil: default"
            return 0
        end
        set -l dir (command $SELF path \$name); or return 1
        set -gx CLAUDE_CONFIG_DIR \$dir
        echo "Aktives Profil: \$name (\$dir)"
        return 0
    end
    command $SELF \$argv
end

complete -c ccacct -f
complete -c ccacct -n '__fish_use_subcommand' -a 'use list add login logout run exec path which sync doctor autosync rm shell-init help'
complete -c ccacct -n '__fish_seen_subcommand_from use run exec path login logout sync doctor rm' -a '(command $SELF list 2>/dev/null | tail -n +2 | string trim | string replace -r "^\\\\*?\\\\s*" "" | string split -f1 " ")'
EOF
      ;;
    bash|zsh) cat <<EOF
# ccacct — bash/zsh-Integration.  In .bashrc/.zshrc:  eval "\$($SELF shell-init bash)"
ccacct() {
  if [ "\${1:-}" = "use" ]; then
    if [ -z "\${2:-}" ]; then echo "Aufruf: ccacct use <name>" >&2; return 1; fi
    if [ "\$2" = "default" ]; then
      unset CLAUDE_CONFIG_DIR
      echo "Aktives Profil: default"
      return 0
    fi
    local dir
    dir="\$(command $SELF path "\$2")" || return 1
    export CLAUDE_CONFIG_DIR="\$dir"
    echo "Aktives Profil: \$2 (\$dir)"
    return 0
  fi
  command $SELF "\$@"
}
EOF
      ;;
    *) die "unbekannte Shell: '${shell:-}' (unterstützt: fish, bash, zsh)" ;;
  esac
}

cmd_help() {
  cat <<EOF
ccacct — mehrere Claude-Code-Accounts parallel halten und nahtlos wechseln

  ccacct list                       Profile mit Account, Abo und Login-Status
  ccacct add <name> [--isolate-projects]
                                    Neues Profil anlegen (Symlinks auf default)
  ccacct login <name>               Claude Code starten und in dem Profil anmelden
  ccacct logout <name>              Aus dem Profil abmelden
  ccacct use <name>                 Profil für die aktuelle Shell aktivieren
                                    (benötigt 'ccacct shell-init', s.u.)
  ccacct run <name> [args…]         Einmalig Claude Code in dem Profil starten
  ccacct exec <name> -- <cmd…>      Beliebiges Kommando im Profilkontext ausführen
  ccacct which                      Aktuell aktives Profil
  ccacct path <name>                Configdir des Profils
  ccacct sync [<name>|--all] [--links-only] [--force] [--quiet]
                                    Setup-Spiegelung nachziehen
  ccacct doctor [<name>|--all] [--fix]
                                    Prüfen, ob jedes Profil identisch zu default ist
  ccacct autosync install|uninstall|status
                                    Bei jedem Sessionstart automatisch syncen
  ccacct rm <name> --force          Profil samt Anmeldung löschen
  ccacct shell-init fish|bash|zsh   Shell-Integration ausgeben

Das Setup liegt genau einmal in $PRIMARY. Profile verlinken darauf — keine Kopien.
Getrennt ist nur der Account: .credentials.json, die Identitätsschlüssel in
.claude.json sowie History, Sessions und Tasks.

Umgebungsvariablen: CCACCT_PRIMARY, CCACCT_ROOT, CCACCT_CLAUDE_BIN
EOF
}

# ------------------------------------------------------------------- Main ----
main() {
  local cmd="${1:-list}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    list|ls)          cmd_list "$@" ;;
    add|new|create)   cmd_add "$@" ;;
    login)            cmd_login "$@" ;;
    logout)           cmd_logout "$@" ;;
    run)              cmd_run "$@" ;;
    exec)             cmd_exec "$@" ;;
    which|current)    cmd_which "$@" ;;
    path|dir)         cmd_path "$@" ;;
    sync)             cmd_sync "$@" ;;
    doctor|check)     cmd_doctor "$@" ;;
    autosync)         cmd_autosync "$@" ;;
    rm|remove|delete) cmd_rm "$@" ;;
    shell-init)       cmd_shell_init "$@" ;;
    use)              die "'use' muss die Shell selbst ausführen — richte die Integration ein: ccacct shell-init fish | source" ;;
    help|-h|--help)   cmd_help ;;
    *)                die "unbekanntes Kommando: $cmd (siehe 'ccacct help')" ;;
  esac
}

main "$@"
